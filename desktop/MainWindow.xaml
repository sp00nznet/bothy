<Window x:Class="Bothy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bothy" Height="800" Width="1280"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WinBg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>   <!-- titlebar -->
      <RowDefinition Height="26"/>   <!-- menubar -->
      <RowDefinition Height="46"/>   <!-- command bar -->
      <RowDefinition Height="*"/>    <!-- content -->
      <RowDefinition Height="24"/>   <!-- status bar -->
    </Grid.RowDefinitions>

    <!-- titlebar -->
    <Border Grid.Row="0" Background="{StaticResource WinChrome}">
      <DockPanel LastChildFill="False">
        <Border Width="14" Height="14" Margin="10,0,0,0" DockPanel.Dock="Left"
                VerticalAlignment="Center" BorderBrush="{StaticResource Accent}"
                BorderThickness="2" CornerRadius="2"/>
        <TextBlock DockPanel.Dock="Left" x:Name="TitleText" Text="Bothy" VerticalAlignment="Center"
                   Margin="9,0,0,0" FontSize="12" Foreground="{StaticResource Fg2}"/>
        <Button DockPanel.Dock="Right" Width="44" Style="{StaticResource CmdButton}" Height="32"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Fg2}"/></Button>
        <Button DockPanel.Dock="Right" Width="44" Style="{StaticResource CmdButton}" Height="32"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Fg2}"/></Button>
        <Button DockPanel.Dock="Right" Width="44" Style="{StaticResource CmdButton}" Height="32"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Fg2}"/></Button>
      </DockPanel>
    </Border>

    <!-- menubar -->
    <Border Grid.Row="1" Background="{StaticResource WinChrome}">
      <Menu VerticalAlignment="Center" Margin="6,0">
        <MenuItem Header="File"/><MenuItem Header="Edit"/><MenuItem Header="View"/>
        <MenuItem Header="Deploy"/><MenuItem Header="Providers"><MenuItem Header="Properties…" Click="Provider_Click"/></MenuItem>
        <MenuItem Header="Tools"/><MenuItem Header="Help"/>
      </Menu>
    </Border>

    <!-- command bar -->
    <Border Grid.Row="2" Background="{StaticResource WinHeader}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False" Margin="10,0">
        <Button Style="{StaticResource AccentButton}" DockPanel.Dock="Left" Margin="0,0,10,0" Click="Deploy_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12"
                       Foreground="{StaticResource AccentOn}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="Deploy" Foreground="{StaticResource AccentOn}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="9"
                       Foreground="{StaticResource AccentOn}" VerticalAlignment="Center" Margin="8,1,0,0"/>
          </StackPanel>
        </Button>

        <Button Style="{StaticResource CmdButton}" DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource Fg2}"/>
            <TextBlock Text="Batch…" VerticalAlignment="Center"/>
            <TextBlock Text="Ctrl+B" Style="{StaticResource Shortcut}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource CmdButton}" DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource Fg2}"/>
            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
            <TextBlock Text="F5" Style="{StaticResource Shortcut}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource CmdButton}" DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource Danger}"/>
            <TextBlock Text="Destroy" VerticalAlignment="Center"/>
            <TextBlock Text="Del" Style="{StaticResource Shortcut}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource CmdButton}" DockPanel.Dock="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource Fg2}"/>
            <TextBlock Text="Columns" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource CmdButton}" DockPanel.Dock="Left" Click="Monitor_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{StaticResource Fg2}"/>
            <TextBlock Text="Monitor" VerticalAlignment="Center"/>
            <TextBlock Text="Ctrl+M" Style="{StaticResource Shortcut}"/>
          </StackPanel>
        </Button>

        <TextBox DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" Text="Filter this view"
                 Foreground="{StaticResource Fg4}"/>
      </DockPanel>
    </Border>

    <!-- content: tree | list | details -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="296"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource WinPanel}"
              BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
        <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Margin="4,6,0,0"/>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="{StaticResource WinBg}"/>

      <ListView x:Name="List" Grid.Column="2" Background="Transparent" BorderThickness="0"
                ItemContainerStyle="{StaticResource RowStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
          <GridView AllowsColumnReorder="True">
            <GridViewColumn Width="22">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="8,0,0,0"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="VMID" Width="52">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Vmid}" Style="{StaticResource Mono}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Hostname ▲" Width="186">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Hostname}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Address" Width="146">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Address}" Style="{StaticResource Mono}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="CPU" Width="74">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Cpu}" Style="{StaticResource Mono}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Memory" Width="88">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Memory}" Style="{StaticResource Mono}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Uptime" Width="82">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Uptime}" Style="{StaticResource Mono}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Route" Width="92">
              <GridViewColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Route}" Foreground="{Binding RouteBrush}" Margin="8,0,0,0"/></DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>

        <ListView.ContextMenu>
          <ContextMenu Background="{StaticResource WinFlyout}" Width="214">
            <MenuItem Header="Open in browser" InputGestureText="Enter"/>
            <MenuItem Header="Console (Guacamole)" InputGestureText="Ctrl+`"/>
            <Separator/>
            <MenuItem Header="Restart"/>
            <MenuItem Header="Stop"/>
            <MenuItem Header="Re-run reachability check"/>
            <Separator/>
            <MenuItem Header="Redeploy from definition…"/>
            <MenuItem Header="Copy address" InputGestureText="Ctrl+C"/>
            <Separator/>
            <MenuItem Header="Destroy…" InputGestureText="Del" Foreground="{StaticResource Danger}"/>
          </ContextMenu>
        </ListView.ContextMenu>
      </ListView>

      <!-- details pane -->
      <Border Grid.Column="3" Background="{StaticResource WinPanel}"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
        <StackPanel Margin="16,14" x:Name="Details">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="6" Background="#12FFFFFF"
                    BorderBrush="#14FFFFFF" BorderThickness="1">
              <TextBlock Text="PL" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontWeight="SemiBold" Foreground="#C3C3CB"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="DetailName" Text="plex" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="DetailSub" Text="LXC 100 · running 14d 6h" Style="{StaticResource Mono}" FontSize="11"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="IDENTITY" Style="{StaticResource LabelUp}" Margin="0,18,0,7"/>
          <Grid x:Name="IdentityGrid"/>
          <TextBlock Text="RESOURCES" Style="{StaticResource LabelUp}" Margin="0,16,0,7"/>
          <Grid x:Name="ResourcesGrid"/>
          <TextBlock Text="HEALTH" Style="{StaticResource LabelUp}" Margin="0,16,0,7"/>
          <Grid x:Name="HealthGrid"/>

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource CmdButton}" Height="30"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1">
              <TextBlock Text="Open ↗"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource CmdButton}" Height="30"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1">
              <TextBlock Text="Console"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- status bar -->
    <Border Grid.Row="4" Background="{StaticResource WinChrome}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0" LastChildFill="False">
        <TextBlock x:Name="StatusLeft" DockPanel.Dock="Left" Text="loading…" VerticalAlignment="Center"
                   Foreground="{StaticResource Fg3}" FontSize="11"/>
        <TextBlock x:Name="StatusMid" DockPanel.Dock="Left" Text="connecting…" VerticalAlignment="Center"
                   Foreground="{StaticResource Fg3}" FontSize="11" Margin="18,0,0,0"/>

        <TextBlock DockPanel.Dock="Right" Text="F5 refresh · Del destroy · F2 rename"
                   VerticalAlignment="Center" Style="{StaticResource Mono}"
                   Foreground="{StaticResource Fg4}" FontSize="10.5"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
