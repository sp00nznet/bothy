<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Windows client tokens from the handoff -->
  <SolidColorBrush x:Key="WinBg"      Color="#202024"/>
  <SolidColorBrush x:Key="WinChrome"  Color="#191919"/>
  <SolidColorBrush x:Key="WinPanel"   Color="#1D1D21"/>
  <SolidColorBrush x:Key="WinHeader"  Color="#25252A"/>
  <SolidColorBrush x:Key="WinFlyout"  Color="#2B2B30"/>
  <SolidColorBrush x:Key="WinInput"   Color="#1A1A1E"/>
  <SolidColorBrush x:Key="Fg"         Color="#DCDCDF"/>
  <SolidColorBrush x:Key="Fg2"        Color="#B4B4BC"/>
  <SolidColorBrush x:Key="Fg3"        Color="#8A8A94"/>
  <SolidColorBrush x:Key="Fg4"        Color="#7C7C86"/>
  <SolidColorBrush x:Key="Accent"     Color="#4CC2FF"/>
  <SolidColorBrush x:Key="AccentOn"   Color="#06212E"/>
  <SolidColorBrush x:Key="AccentWash" Color="#264C6478"/>
  <SolidColorBrush x:Key="Ok"         Color="#6CCB5F"/>
  <SolidColorBrush x:Key="OkText"     Color="#8FDC84"/>
  <SolidColorBrush x:Key="Warn"       Color="#F2C744"/>
  <SolidColorBrush x:Key="Danger"     Color="#FF8A95"/>
  <SolidColorBrush x:Key="Stroke"     Color="#22FFFFFF"/>
  <SolidColorBrush x:Key="Divider"    Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="Hover"      Color="#0DFFFFFF"/>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
  </Style>

  <Style x:Key="Shortcut" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
    <Setter Property="Foreground" Value="{StaticResource Fg4}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
  </Style>

  <Style x:Key="LabelUp" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
  </Style>

  <!-- command bar button: glyph + label + dimmed shortcut -->
  <Style x:Key="CmdButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource CmdButton}">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource AccentOn}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style TargetType="Menu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
    <Setter Property="Padding" Value="9,3"/>
  </Style>

  <!-- ListView details mode, 26px rows -->
  <Style x:Key="RowStyle" TargetType="ListViewItem">
    <Setter Property="Height" Value="26"/>
    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="b" Background="Transparent" BorderThickness="0,0,0,1"
                  BorderBrush="{StaticResource Divider}">
            <GridViewRowPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="#264CC2FF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Background" Value="{StaticResource WinHeader}"/>
    <Setter Property="Foreground" Value="{StaticResource Fg3}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
  </Style>

  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    <Setter Property="IsExpanded" Value="True"/>
    <Setter Property="Padding" Value="2,0"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource WinInput}"/>
    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
  </Style>
</ResourceDictionary>
