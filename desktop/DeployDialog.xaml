<Window x:Class="Bothy.Desktop.DeployDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Deploy" Width="640" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource WinBg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="8" Background="{StaticResource WinBg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="50"/>
      </Grid.RowDefinitions>

      <!-- dialog titlebar -->
      <Border Grid.Row="0" Background="{StaticResource WinChrome}" CornerRadius="8,8,0,0">
        <DockPanel LastChildFill="False">
          <TextBlock x:Name="DlgTitle" DockPanel.Dock="Left" Text="Deploy Gitea — Resources"
                     VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Fg2}"/>
          <Button DockPanel.Dock="Right" Width="44" Height="32" Style="{StaticResource CmdButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                       FontSize="10" Foreground="{StaticResource Fg2}"/></Button>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="176"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- step rail -->
        <Border Grid.Column="0" Background="{StaticResource WinPanel}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
          <StackPanel Margin="10,12">
            <Border Background="Transparent" Padding="9,7" CornerRadius="4">
              <TextBlock Foreground="{StaticResource OkText}"><Run Text="&#10003;  Application"/></TextBlock></Border>
            <Border Background="Transparent" Padding="9,7" CornerRadius="4">
              <TextBlock Foreground="{StaticResource OkText}"><Run Text="&#10003;  Target"/></TextBlock></Border>
            <Border Background="#264CC2FF" Padding="9,7" CornerRadius="4">
              <TextBlock Text="Resources" FontWeight="SemiBold" Foreground="#BFE8FF"/></Border>
            <Border Padding="9,7"><TextBlock Text="Network" Foreground="{StaticResource Fg3}"/></Border>
            <Border Padding="9,7"><TextBlock Text="Review" Foreground="{StaticResource Fg3}"/></Border>
            <TextBlock Margin="9,14,4,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource Fg4}" LineHeight="16"
                       Text="Only 4 steps show for LXC targets. Cloud targets add a Region step."/>
          </StackPanel>
        </Border>

        <!-- body -->
        <StackPanel Grid.Column="1" Margin="18,16">
          <TextBlock Text="PRESET" Style="{StaticResource LabelUp}" Margin="0,0,0,8"/>
          <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4"
                  HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
              <Border Padding="14,6"><TextBlock Text="Small" Foreground="{StaticResource Fg3}"/></Border>
              <Border Background="#264CC2FF" Padding="14,6">
                <TextBlock Text="Recommended" FontWeight="SemiBold" Foreground="#BFE8FF"/></Border>
              <Border Padding="14,6"><TextBlock Text="Custom" Foreground="{StaticResource Fg3}"/></Border>
            </StackPanel>
          </Border>

          <Grid x:Name="FieldGrid"/>

          <StackPanel Margin="0,14,0,0">
            <CheckBox IsChecked="True" Foreground="{StaticResource Fg}" Margin="0,0,0,7">
              <TextBlock Text="Start after creation"/></CheckBox>
            <CheckBox IsChecked="True" Foreground="{StaticResource Fg}" Margin="0,0,0,7">
              <TextBlock Text="Register Traefik route"/></CheckBox>
            <CheckBox Foreground="{StaticResource Fg}">
              <TextBlock Text="Enable nesting (needed for Docker-in-LXC)"/></CheckBox>
          </StackPanel>

          <Border Background="#146CCB5F" BorderBrush="#386CCB5F" BorderThickness="1"
                  CornerRadius="5" Padding="10,8" Margin="0,16,0,0">
            <TextBlock x:Name="FitText" Foreground="{StaticResource OkText}" FontSize="11.5"
                       Text="&#10003; Fits pve01 — 38% headroom remains"/>
          </Border>
        </StackPanel>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" Background="{StaticResource WinPanel}"
              BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
        <DockPanel LastChildFill="False" Margin="14,0">
          <TextBlock x:Name="VmidText" DockPanel.Dock="Left" VerticalAlignment="Center"
                     Style="{StaticResource Mono}" FontSize="11"
                     Foreground="{StaticResource Fg4}" Text="vmid 129 reserved"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource CmdButton}" Height="30" Width="86"
                  BorderBrush="{StaticResource Stroke}" BorderThickness="1" Margin="8,0,0,0"
                  Click="Cancel_Click"><TextBlock Text="Cancel"/></Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="30" Width="86"
                  Margin="8,0,0,0" Click="Next_Click"><TextBlock Text="Next" Foreground="{StaticResource AccentOn}"
                  FontWeight="SemiBold"/></Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource CmdButton}" Height="30" Width="76"
                  BorderBrush="{StaticResource Stroke}" BorderThickness="1"><TextBlock Text="Back"/></Button>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
