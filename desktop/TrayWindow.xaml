<Window x:Class="Bothy.Desktop.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bothy — tray and notification" Width="640" Height="360"
        WindowStyle="None" ResizeMode="NoResize" Background="#0C0C0F"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- D5: the toast and the tray menu shown together on one surface, since neither
       is a window a user positions themselves. -->
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="352"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="236"/>
    </Grid.ColumnDefinitions>

    <!-- toast -->
    <Border Grid.Column="0" VerticalAlignment="Top" Background="{StaticResource WinFlyout}"
            BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="6" Padding="14">
      <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.55" Color="Black"/></Border.Effect>
      <StackPanel>
        <DockPanel LastChildFill="False">
          <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6"
                  BorderBrush="{StaticResource Accent}" BorderThickness="2" Margin="0,0,10,0"
                  Padding="5">
            <UniformGrid Rows="2" Columns="2">
              <Border Background="{StaticResource Accent}" Opacity="0.85" CornerRadius="1" Margin="0.5"/>
              <Border Background="{StaticResource Accent}" Opacity="0.85" CornerRadius="1" Margin="0.5"/>
              <Border Background="{StaticResource Accent}" Opacity="0.85" CornerRadius="1" Margin="0.5"/>
              <Border Background="{StaticResource Accent}" Opacity="0.85" CornerRadius="1" Margin="0.5"/>
            </UniformGrid>
          </Border>
          <TextBlock DockPanel.Dock="Left" Text="Batch #48 finished" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Text="&#xE8BB;" VerticalAlignment="Top"
                     FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10"
                     Foreground="{StaticResource Fg4}"/>
        </DockPanel>
        <TextBlock Margin="40,6,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                   Foreground="{StaticResource Fg2}"
                   Text="Harbor, Gitea deployed. SigNoz skipped — no provider assigned."/>
        <TextBlock Margin="40,8,0,0" FontSize="11" Foreground="{StaticResource Fg4}" Text="Bothy · now"/>
        <Border Height="1" Background="{StaticResource Stroke}" Margin="0,12,0,0"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Open monitor" HorizontalAlignment="Center"
                     Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11.5"/>
          <TextBlock Grid.Column="1" Text="Dismiss" HorizontalAlignment="Center"
                     Foreground="{StaticResource Fg2}" FontSize="11.5"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- tray menu -->
    <Border Grid.Column="2" VerticalAlignment="Bottom" Background="{StaticResource WinFlyout}"
            BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="6" Padding="0,5">
      <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="Black"/></Border.Effect>
      <StackPanel x:Name="TrayMenu"/>
    </Border>
  </Grid>
</Window>
